# Postgres
POSTGRES_DB=ventas
DB_OWNER_USER=ventas_owner
DB_OWNER_PASSWORD=cambiar
DB_APP_USER=ventas_app
DB_APP_PASSWORD=cambiar
# Usuario exclusivo de Better Auth (ver docs/specs/autenticacion.md)
DB_AUTH_USER=ventas_auth
DB_AUTH_PASSWORD=cambiar

# Cadenas de conexión para el backend (host)
# Migraciones (ventas_owner), código de negocio (ventas_app) y Better Auth (ventas_auth)
# DATABASE_URL_MIGRATIONS solo la usan drizzle-kit y los tests: no va en el entorno de la API en producción
DATABASE_URL_MIGRATIONS=postgres://ventas_owner:cambiar@localhost:5432/ventas
DATABASE_URL=postgres://ventas_app:cambiar@localhost:5432/ventas
DATABASE_URL_AUTH=postgres://ventas_auth:cambiar@localhost:5432/ventas

# Better Auth
# Secreto de firma (mínimo 32 caracteres): openssl rand -hex 32
BETTER_AUTH_SECRET=cambiar
# URL pública de la API (mismo origen que el panel)
BETTER_AUTH_URL=http://localhost:3000
# Orígenes permitidos, separados por comas (sin path)
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200

# WAHA
WAHA_PORT=3001
# API key de WAHA: se envía en el header X-Api-Key (la usan el contenedor y la API)
WAHA_API_KEY=cambiar
# API de WAHA vista desde el backend (host)
WAHA_BASE_URL=http://localhost:3001
# Webhook de la API visto desde el contenedor de WAHA (se configura en cada sesión)
WAHA_WEBHOOK_URL=http://host.docker.internal:3000/api/webhooks/waha
# Clave HMAC con la que WAHA firma los webhooks (mínimo 32 bytes): openssl rand -hex 32
WAHA_WEBHOOK_HMAC_KEY=cambiar
# Usuario y contraseña del dashboard de WAHA (http://localhost:3001/dashboard)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambiar

# IA (tarea 006)
# Interruptor general: con false la IA no corre en ninguna empresa
AI_ENABLED=false
# Clave de OpenRouter de la plataforma (obligatoria con AI_ENABLED=true). Configurarle un límite de gasto
OPENROUTER_API_KEY=
# Modelo por defecto si la empresa no eligió otro (tiene que estar en ALLOWED_MODELS de libs/shared)
AI_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
