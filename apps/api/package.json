    "dev:send": "tsx scripts/send-dev-message.ts",
    "dev:resume-channel": "tsx scripts/resume-dev-channel.ts",
    "dev:set-config": "tsx scripts/set-tenant-config.ts",
    "dev:import-catalog": "tsx scripts/import-catalog.ts",
    "dev:test-extractor": "tsx scripts/test-extractor.ts",
    "evals": "tsx scripts/evals.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
