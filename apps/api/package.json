    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
