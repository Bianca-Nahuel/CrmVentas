  "knowledge": {
    "faqs": [
      {
        "question": "¿Qué requisitos piden para alquilar?",
        "answer": "Garantía propietaria o seguro de caución, recibos de sueldo o constancia de ingresos y DNI del inquilino al momento de firmar en la oficina."
      },
      {
        "question": "¿Trabajan con créditos hipotecarios?",
        "answer": "Sí, muchas de nuestras propiedades en venta son aptas crédito; un asesor confirma cuáles."
      },
      {
        "question": "¿Cobran comisión al inquilino?",
        "answer": "La comisión del alquiler la explica un asesor según la propiedad y el contrato."
      },
      {
        "question": "¿Hacen tasaciones?",
        "answer": "Sí, hacemos tasaciones de casas, departamentos y locales; las coordina un asesor."
      }
    ],
