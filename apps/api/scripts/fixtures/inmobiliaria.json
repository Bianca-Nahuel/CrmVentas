        "type": "date",
        "how_to_ask": "¿Para cuándo te gustaría mudarte?",
        "required": false,
        "priority": 6
      },
      {
        "key": "nombre",
        "label": "Nombre",
        "type": "string",
        "how_to_ask": "¿Cómo es tu nombre?",
        "required": false,
        "priority": 7,
        "ask_when_score_gte": 60
      }
